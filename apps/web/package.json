{
  "name": "@blog/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "wrangler dev",
    "preview:deploy": "pnpm db:migrate:preview && wrangler preview -c dist/server/wrangler.json",
    "deploy": "vp build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply blog --local",
    "db:migrate": "wrangler d1 migrations apply blog --remote",
    "db:migrate:preview": "wrangler d1 migrations apply blog-preview --remote -c wrangler.preview-migrations.jsonc",
    "db:sync-preview": "node scripts/preview-db.mjs sync-posts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "size": "wrangler deploy -c dist/server/wrangler.json --dry-run"
  },
  "dependencies": {
    "@blog/shared": "workspace:*",
    "@pierre/highlights": "0.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.8",
    "intl-messageformat": "^12.1.4",
    "katex": "^0.18.2",
    "kysely": "^0.29.7",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "~1.65.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxc-transform-react": "^0.155.0",
    "react-grab": "^0.2.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.152.0"
  }
}
