# Cloudflare API credentials for local tooling:
#   - scripts/workers-logs.mjs          (reads .cloudflare/env automatically)
#   - wrangler, via `wrangler --env-file .cloudflare/env <cmd>`
#   - the .claude/skills/diagnose-worker-logs skill
#
# HOW TO CREATE THE TOKEN
#   Cloudflare dashboard -> My Profile -> API Tokens -> Create Token -> Custom.
#   Permissions (Account-level):
#     Workers Scripts        — Edit   (`wrangler deploy`)
#     D1                     — Edit   (`wrangler d1 --remote`)
#     Workers R2 Storage     — Edit   (R2 media bucket)
#     Workers Observability  — Read   (REQUIRED for log search — the OAuth
#                                       `wrangler login` token can't do this)
#     Workers Tail           — Read   (`wrangler tail`)
#     Zone -> Workers Routes — Edit   (custom domains)
#   Account Resources: restrict to this account only.
#
# Copy to `.cloudflare/env` (gitignored) and fill in the token:
#   cp .cloudflare/env.example .cloudflare/env
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=31550921828614c2585591e8ff989ac1
